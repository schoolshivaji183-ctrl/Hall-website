# ==========================================
# MongoDB Atlas & Server Configuration
# ==========================================

# Port for local web server
PORT=3000

# Environment Mode: development | production
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Replace with your actual MongoDB Atlas username, password, cluster URL, and database name
MONGO_URI=mongodb+srv://hall_admin:your_password@cluster0.mongodb.net/hall_booking_erp?retryWrites=true&w=majority

# Target Database Name in Atlas
DB_NAME=hall_booking_erp
